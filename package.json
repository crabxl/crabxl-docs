{
  "name": "crabxl-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "fetch": "node scripts/fetch-sources.mjs",
    "check": "node scripts/check-content.mjs content/docs",
    "dev": "next dev",
    "build": "next build",
