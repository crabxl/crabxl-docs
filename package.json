{
  "name": "crabxl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch": "node scripts/fetch-sources.mjs",
    "check": "node scripts/check-content.mjs content/docs",
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "pnpm run prepare:content && astro dev",
    "build": "pnpm run prepare:content && astro build",
    "build:pages": "pnpm run fetch && pnpm run check && pnpm run build",
    "preview": "astro preview",
    "test": "node --test scripts/*.test.mjs",
    "types:check": "pnpm run prepare:content && astro sync && vp check"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.7",
    "@fumadocs/astro": "0.3.0",
    "astro": "^7.4.10",
    "fumadocs-core": "16.19.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.19.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "takumi-js": "^2.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.28.0"
}
